<Window x:Class="DMT.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [setup.window.title]}"
        Width="1180" Height="760" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#FFF4EE">
    <Border Margin="1" CornerRadius="16" BorderBrush="#C9D4E2" BorderThickness="1" Background="{StaticResource CreamBrush}" Effect="{StaticResource SoftShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Grid Grid.Row="0" Background="#F5F8FC" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Image Source="assets/branding/dmt-logo.png" Width="30" Height="30" Stretch="Uniform" />
                    <TextBlock Text="{Binding [setup.window.title]}" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource WindowButton}" Click="Minimize_Click" ToolTip="{Binding [setup.window.minimize]}">
                        <Grid Width="14" Height="14">
                            <Path Data="M 1.5,8 L 12.5,8"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.4" StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                        </Grid>
                    </Button>

                    <Button x:Name="MaximizeRestoreButton" Click="MaximizeRestore_Click" Content="WindowStateIcon">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource WindowButton}">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <Grid Width="14" Height="14">
                                                <Border Width="11" Height="11" BorderThickness="1.25"
                                                        BorderBrush="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState}" Value="Maximized">
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <Grid Width="14" Height="14">
                                                        <Border Width="9" Height="9" BorderThickness="1.15"
                                                                BorderBrush="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                                HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                        <Border Width="9" Height="9" BorderThickness="1.15" Background="#F5F8FC"
                                                                BorderBrush="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                                HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                                    </Grid>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Style="{StaticResource WindowCloseButton}" Click="Close_Click" ToolTip="{Binding [setup.window.close]}">
                        <Grid Width="14" Height="14">
                            <Path Data="M 2,2 L 12,12 M 12,2 L 2,12"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.4" StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="245" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- navigation -->
                <Border Grid.Column="0" Background="#FFFCF8" CornerRadius="18" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Effect="{StaticResource SoftShadow}" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <Button x:Name="WelcomeNav" Style="{StaticResource NavButton}" Background="{StaticResource PeachBrush}" Click="WelcomeNav_Click" Cursor="Hand">
                                <TextBlock Text="{Binding [setup.step.welcome]}" FontWeight="SemiBold" FontSize="15" />
                            </Button>
                            <Button x:Name="NetworkNav" Style="{StaticResource NavButton}" Background="Transparent" Click="NetworkNav_Click" Cursor="Hand">
                                <TextBlock Text="{Binding [setup.step.network]}" FontWeight="SemiBold" FontSize="15" />
                            </Button>
                            <Button x:Name="AccessNav" Style="{StaticResource NavButton}" Content="{Binding [setup.step.access]}" IsEnabled="False" Click="AccessNav_Click" Cursor="Hand" />
                            <Button x:Name="HttpsNav" Style="{StaticResource NavButton}" Content="{Binding [setup.step.https]}" IsEnabled="False" Click="HttpsNav_Click" Cursor="Hand" />
                            <Button x:Name="AdminNav" Style="{StaticResource NavButton}" Content="{Binding [setup.step.admin]}" IsEnabled="False" Click="AdminNav_Click" Cursor="Hand" />
                            <Button x:Name="SummaryNav" Style="{StaticResource NavButton}" Content="{Binding [setup.step.summary]}" IsEnabled="False" Click="SummaryNav_Click" Cursor="Hand" />
                            <Button x:Name="InstallNav" Style="{StaticResource NavButton}" Content="{Binding [setup.step.install]}" IsEnabled="False" />
                            <Button x:Name="CompleteNav" Style="{StaticResource NavButton}" Content="{Binding [setup.step.complete]}" IsEnabled="False" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="10,20,10,7">
                            <TextBlock Text="KRAUGH" FontSize="22" FontWeight="Light" HorizontalAlignment="Center" Foreground="#7D8797" />
                            <TextBlock Text="{Binding [setup.brand.caption]}" FontSize="10" HorizontalAlignment="Stretch" Margin="0,5,0,0" Foreground="#9AA2AE"
                                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="185" MinHeight="26" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- main -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="assets/branding/dmt-logo.png" Width="88" Height="88" Stretch="Uniform" Margin="0,0,16,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="DMT" FontSize="54" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Text="{Binding [app.subtitle]}" FontSize="22" Foreground="{StaticResource InkSoftBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <TextBlock Text="{Binding [setup.language.label]}" FontSize="14" Margin="0,8,10,0" Foreground="{StaticResource InkSoftBrush}" />
                            <ComboBox Width="170" Height="36" ItemsSource="{Binding VisibleLanguages}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" Padding="8,3" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="WelcomePanel" Grid.Row="1" Margin="0,26,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Border Width="82" Height="5" CornerRadius="3" Background="#F5B390" HorizontalAlignment="Left" Margin="0,0,0,24" />
                            <TextBlock Text="{Binding [setup.welcome.title]}" FontSize="34" FontWeight="Bold" Margin="0,0,0,22" />
                            <TextBlock Text="{Binding [setup.welcome.body]}" FontSize="18" LineHeight="27" TextWrapping="Wrap" MaxWidth="540" />
                            <TextBlock Text="{Binding [setup.welcome.nochanges]}" FontSize="17" FontWeight="SemiBold" Margin="0,20,0,0" TextWrapping="Wrap" />

                            <Border Margin="0,28,0,0" Background="#FFFCF9" CornerRadius="15" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18" Effect="{StaticResource SoftShadow}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding [setup.benefit.simple.title]}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="{Binding [setup.benefit.simple.body]}" FontSize="12" Margin="0,4,8,0" Foreground="{StaticResource InkSoftBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding [setup.benefit.safe.title]}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="{Binding [setup.benefit.safe.body]}" FontSize="12" Margin="0,4,8,0" Foreground="{StaticResource InkSoftBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding [setup.benefit.fit.title]}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="{Binding [setup.benefit.fit.body]}" FontSize="12" Margin="0,4,0,0" Foreground="{StaticResource InkSoftBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Librarian placeholder card; badge is the hidden language trigger -->
                        <Border Grid.Column="2" Background="#FFF8EE" CornerRadius="18" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="22" Effect="{StaticResource SoftShadow}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Image Source="assets/branding/dmt-logo.png" Width="220" Height="220" Stretch="Uniform" />
                                    <TextBlock Text="{Binding [setup.librarian.caption]}" FontSize="15" FontStyle="Italic" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300" Margin="0,16,0,0" Foreground="{StaticResource InkSoftBrush}" />
                                </StackPanel>
                                <Button Grid.Row="1" Width="40" Height="54" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Badge_Click" ToolTip="">
                                    <Path Data="M20,2 L37,20 L27,49 L20,40 L13,49 L3,20 Z" Fill="#E9B85E" Stroke="#6E522C" StrokeThickness="1.5" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="NetworkPanel" Grid.Row="1" Margin="0,22,0,0" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel>
                            <Border Width="82" Height="5" CornerRadius="3" Background="#F5B390" HorizontalAlignment="Left" Margin="0,0,0,18" />
                            <TextBlock Text="{Binding [setup.network.title]}" FontSize="32" FontWeight="Bold" />
                            <TextBlock Text="{Binding [setup.network.body]}" FontSize="15" LineHeight="22" TextWrapping="Wrap" Margin="0,8,0,0" MaxWidth="820" HorizontalAlignment="Left" />
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,18,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
                            <Border Background="{StaticResource PowderBrush}" CornerRadius="14" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding [setup.network.selectedPort]}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SelectedPortBox" Grid.Column="1" Height="38" Margin="16,0,10,0" Padding="9,5"
                                             FontSize="18" FontWeight="Bold" VerticalContentAlignment="Center"
                                             TextChanged="SelectedPort_TextChanged" ToolTip="{Binding [setup.network.portHint]}"/>
                                    <TextBlock x:Name="SelectedPortStatusText" Grid.Column="2" VerticalAlignment="Center"
                                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource SecondaryButton}" Click="ExportPorts_Click" Padding="16,10" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding [setup.network.export]}" FontWeight="SemiBold"/>
                                </Button>
                                <Button Style="{StaticResource PrimaryButton}" Click="RefreshPorts_Click" Padding="18,10">
                                    <TextBlock Text="{Binding [setup.network.refresh]}" Foreground="White" FontWeight="SemiBold"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="PortFilterBox" Height="36" Padding="10,7" TextChanged="PortFilter_TextChanged" ToolTip="{Binding [setup.network.search]}"/>
                                <TextBlock Grid.Column="1" x:Name="ListenerStatusText" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource InkSoftBrush}"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding [setup.network.search]}" FontSize="11" Foreground="{StaticResource InkSoftBrush}" Margin="2,4,0,8"/>
                            <DataGrid x:Name="PortsGrid" Grid.Row="2" MinHeight="180" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                      Background="#FFFCF9" RowBackground="#FFFCF9" AlternatingRowBackground="#FFF8F2" SelectionMode="Single"
                                      EnableRowVirtualization="True" SelectionChanged="PortsGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn x:Name="PortColumn" Header="" Binding="{Binding Port}" Width="70"/>
                                    <DataGridTextColumn x:Name="BindingColumn" Header="" Binding="{Binding Address}" Width="150"/>
                                    <DataGridTextColumn x:Name="PidColumn" Header="" Binding="{Binding ProcessId}" Width="70"/>
                                    <DataGridTextColumn x:Name="ProcessColumn" Header="" Binding="{Binding ProcessName}" Width="150"/>
                                    <DataGridTextColumn x:Name="ServiceColumn" Header="" Binding="{Binding Services}" Width="*" MinWidth="160"/>
                                    <DataGridTextColumn x:Name="ExposureColumn" Header="" Binding="{Binding ExposureDisplay}" Width="145"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border x:Name="ListenerDetailsCard" Grid.Row="3" Visibility="Collapsed" Margin="0,12,0,0"
                                    Background="#FFFCF9" CornerRadius="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Padding="16" Effect="{StaticResource SoftShadow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="0.85*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding [setup.network.detected.title]}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkSoftBrush}" Margin="0,0,0,8"/>
                                        <WrapPanel>
                                            <TextBlock x:Name="DetailEndpointText" FontSize="20" FontWeight="Bold" Margin="0,0,18,6"/>
                                            <Border x:Name="DetailExposureBadge" CornerRadius="9" Background="{StaticResource PowderBrush}" Padding="9,4" Margin="0,0,0,6">
                                                <TextBlock x:Name="DetailExposureText" FontSize="12" FontWeight="SemiBold"/>
                                            </Border>
                                        </WrapPanel>
                                        <Grid Margin="0,7,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding [setup.network.detail.process]}" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="DetailProcessText" Grid.Column="1" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="1" Text="{Binding [setup.network.detail.service]}" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="DetailServiceText" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="2" Text="{Binding [setup.network.detail.path]}" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="DetailPathText" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="3" Text="{Binding [setup.network.detail.description]}" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="DetailDescriptionText" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="4" Text="{Binding [setup.network.detail.company]}" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="DetailCompanyText" Grid.Row="4" Grid.Column="1" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="5" Text="{Binding [setup.network.detail.signature]}" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="DetailSignatureText" Grid.Row="5" Grid.Column="1" TextWrapping="Wrap"/>
                                        </Grid>
                                    </StackPanel>

                                    <Border Grid.Column="2" Background="{StaticResource SageBrush}" CornerRadius="12" Padding="15">
                                        <StackPanel>
                                            <TextBlock Text="{Binding [setup.network.knowledge.label]}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkSoftBrush}"/>
                                            <TextBlock x:Name="KnowledgeTitleText" FontSize="17" FontWeight="Bold" Margin="0,7,0,7" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="KnowledgeBodyText" FontSize="13" LineHeight="19" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding [setup.network.knowledge.disclaimer]}" FontSize="10" Foreground="{StaticResource InkSoftBrush}"
                                                       TextWrapping="Wrap" Margin="0,12,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="AccessPanel" Grid.Row="1" Margin="0,22,0,0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <Border Width="82" Height="5" CornerRadius="3" Background="#F5B390" HorizontalAlignment="Left" Margin="0,0,0,18" />
                            <TextBlock Text="{Binding [setup.access.title]}" FontSize="32" FontWeight="Bold" />
                            <TextBlock Text="{Binding [setup.access.body]}" FontSize="15" LineHeight="22" TextWrapping="Wrap" Margin="0,8,0,0" MaxWidth="820" HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,24,0,0">
                            <Border x:Name="AccessLocalCard" Background="#FFFCF9" CornerRadius="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18" Margin="0,0,0,12">
                                <RadioButton x:Name="AccessLocalRadio" GroupName="AccessMode" IsChecked="True" Checked="AccessMode_Checked" Tag="local">
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="{Binding [setup.access.local.title]}" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding [setup.access.local.body]}" FontSize="14" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>
                            </Border>

                            <Border x:Name="AccessLanCard" Background="#FFFCF9" CornerRadius="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18" Margin="0,0,0,12">
                                <RadioButton x:Name="AccessLanRadio" GroupName="AccessMode" Checked="AccessMode_Checked" Tag="lan">
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="{Binding [setup.access.lan.title]}" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding [setup.access.lan.body]}" FontSize="14" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>
                            </Border>

                            <Border x:Name="AccessCustomCard" Background="#FFFCF9" CornerRadius="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18">
                                <StackPanel>
                                    <RadioButton x:Name="AccessCustomRadio" GroupName="AccessMode" Checked="AccessMode_Checked" Tag="custom">
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="{Binding [setup.access.custom.title]}" FontSize="18" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding [setup.access.custom.body]}" FontSize="14" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </RadioButton>
                                    <ComboBox x:Name="AccessInterfaceBox" Margin="28,14,0,0" MinHeight="34" DisplayMemberPath="DisplayLabel"
                                              SelectionChanged="AccessInterface_SelectionChanged" IsEnabled="False" />
                                    <TextBlock x:Name="AccessInterfaceEmptyText" Text="{Binding [setup.access.custom.none]}"
                                               Foreground="{StaticResource InkSoftBrush}" FontSize="12" Margin="28,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="HttpsPanel" Grid.Row="1" Margin="0,22,0,0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <Border Width="82" Height="5" CornerRadius="3" Background="#F5B390" HorizontalAlignment="Left" Margin="0,0,0,18" />
                            <TextBlock Text="{Binding [setup.https.title]}" FontSize="32" FontWeight="Bold" />
                            <TextBlock Text="{Binding [setup.https.body]}" FontSize="15" LineHeight="22" TextWrapping="Wrap" Margin="0,8,0,0" MaxWidth="820" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,24,0,0">
                            <Border x:Name="HttpsInternalCard" Background="#FFFCF9" CornerRadius="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18" Margin="0,0,0,12">
                                <RadioButton x:Name="HttpsInternalRadio" GroupName="HttpsMode" IsChecked="True" Checked="HttpsMode_Checked">
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="{Binding [setup.https.internal.title]}" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding [setup.https.internal.body]}" FontSize="14" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        <Border Background="{StaticResource SageBrush}" CornerRadius="8" Padding="10,7" Margin="0,10,0,0" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding [setup.https.recommended]}" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                </RadioButton>
                            </Border>
                            <Border x:Name="HttpsExistingCard" Background="#FFFCF9" CornerRadius="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18">
                                <RadioButton x:Name="HttpsExistingRadio" GroupName="HttpsMode" Checked="HttpsMode_Checked">
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="{Binding [setup.https.existing.title]}" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding [setup.https.existing.body]}" FontSize="14" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding [setup.https.existing.note]}" FontSize="12" Foreground="{StaticResource InkSoftBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>
                            </Border>
                            <Border Background="{StaticResource PowderBrush}" CornerRadius="12" Padding="14" Margin="0,14,0,0">
                                <TextBlock Text="{Binding [setup.https.notice]}" FontSize="12" LineHeight="18" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Grid>


                    <Grid x:Name="AdminPanel" Grid.Row="1" Margin="0,22,0,0" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel>
                            <Border Width="82" Height="5" CornerRadius="3" Background="#F5B390" HorizontalAlignment="Left" Margin="0,0,0,18" />
                            <TextBlock Text="{Binding [setup.admin.title]}" FontSize="32" FontWeight="Bold" />
                            <TextBlock Text="{Binding [setup.admin.body]}" FontSize="15" LineHeight="22" TextWrapping="Wrap" Margin="0,8,0,0" MaxWidth="820" HorizontalAlignment="Left" />
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,22,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding [setup.admin.username]}" FontSize="13" FontWeight="SemiBold" />
                                <TextBox x:Name="AdminUsernameBox" Height="36" Margin="0,6,0,14" Padding="9,5" TextChanged="AdminField_Changed" />
                                <TextBlock Text="{Binding [setup.admin.displayName]}" FontSize="13" FontWeight="SemiBold" />
                                <TextBox x:Name="AdminDisplayNameBox" Height="36" Margin="0,6,0,14" Padding="9,5" />
                                <TextBlock Text="{Binding [setup.admin.displayNameHint]}" FontSize="12" Foreground="{StaticResource InkSoftBrush}" TextWrapping="Wrap" Margin="0,-8,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding [setup.admin.password]}" FontSize="13" FontWeight="SemiBold" />
                                <PasswordBox x:Name="AdminPasswordBox" Height="36" Margin="0,6,0,14" Padding="9,5" PasswordChanged="AdminField_Changed" />
                                <TextBlock Text="{Binding [setup.admin.confirmPassword]}" FontSize="13" FontWeight="SemiBold" />
                                <PasswordBox x:Name="AdminConfirmPasswordBox" Height="36" Margin="0,6,0,10" Padding="9,5" PasswordChanged="AdminField_Changed" />
                                <TextBlock x:Name="AdminValidationText" FontSize="12" Foreground="{StaticResource InkSoftBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.ColumnSpan="3" VerticalAlignment="Bottom" Background="{StaticResource PowderBrush}" CornerRadius="12" Padding="14" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding [setup.admin.recovery.title]}" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding [setup.admin.recovery.body]}" FontSize="12" LineHeight="18" TextWrapping="Wrap" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="SummaryPanel" Grid.Row="1" Margin="0,22,0,0" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel>
                            <Border Width="82" Height="5" CornerRadius="3" Background="#F5B390" HorizontalAlignment="Left" Margin="0,0,0,18" />
                            <TextBlock Text="{Binding [setup.summary.title]}" FontSize="32" FontWeight="Bold" />
                            <TextBlock Text="{Binding [setup.summary.body]}" FontSize="15" LineHeight="22" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                        <Border Grid.Row="1" Background="#FFFCF9" CornerRadius="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="20" Margin="0,22,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="{Binding [setup.summary.port]}" FontWeight="SemiBold" Margin="0,0,12,12"/><TextBlock x:Name="SummaryPortText" Grid.Column="1" Margin="0,0,0,12"/>
                                <TextBlock Grid.Row="1" Text="{Binding [setup.summary.access]}" FontWeight="SemiBold" Margin="0,0,12,12"/><TextBlock x:Name="SummaryAccessText" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="2" Text="{Binding [setup.summary.https]}" FontWeight="SemiBold" Margin="0,0,12,12"/><TextBlock x:Name="SummaryHttpsText" Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="3" Text="{Binding [setup.summary.admin]}" FontWeight="SemiBold" Margin="0,0,12,12"/><TextBlock x:Name="SummaryAdminText" Grid.Row="3" Grid.Column="1" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="4" Text="{Binding [setup.summary.recovery]}" FontWeight="SemiBold" Margin="0,0,12,0"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding [setup.summary.recoveryValue]}" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid x:Name="InstallPanel" Grid.Row="1" Margin="0,22,0,0" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel>
                            <Border Width="82" Height="5" CornerRadius="3" Background="#F5B390" HorizontalAlignment="Left" Margin="0,0,0,18" />
                            <TextBlock Text="{Binding [setup.install.title]}" FontSize="32" FontWeight="Bold" />
                            <TextBlock Text="{Binding [setup.install.body]}" FontSize="15" LineHeight="22" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                        <Border Grid.Row="1" Background="#FFFCF9" CornerRadius="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="22" Margin="0,22,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource PowderBrush}" Margin="0,0,14,0">
                                        <TextBlock Text="UAC" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding [setup.install.uac.title]}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding [setup.install.uac.body]}" FontSize="12" Foreground="{StaticResource InkSoftBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                <ProgressBar x:Name="InstallProgressBar" Grid.Row="1" Height="12" Minimum="0" Maximum="100" Value="0" Margin="0,24,0,0" />
                                <TextBlock x:Name="InstallStatusText" Grid.Row="2" Text="{Binding [setup.install.status.ready]}" FontSize="14" FontWeight="SemiBold" Margin="0,14,0,0" TextWrapping="Wrap" />
                                <Border Grid.Row="3" VerticalAlignment="Bottom" Background="{StaticResource PowderBrush}" CornerRadius="12" Padding="14" Margin="0,22,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [setup.install.foundation.title]}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding [setup.install.foundation.body]}" FontSize="12" LineHeight="18" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="CompletePanel" Grid.Row="1" Margin="0,22,0,0" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620">
                            <Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource PowderBrush}" Margin="0,0,0,20">
                                <TextBlock Text="✓" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding [setup.complete.title]}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding [setup.complete.body]}" FontSize="15" LineHeight="22" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,22,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BackButton" Style="{StaticResource SecondaryButton}" Content="{Binding [setup.network.back]}" Click="Back_Click" Visibility="Collapsed" Margin="0,0,12,0"/>
                            <TextBlock Text="DMT Setup 0.1.0-dev   |   &#169; 2026 Kraugh" Foreground="{StaticResource InkSoftBrush}" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                        <Button x:Name="BeginButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Click="Begin_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="BeginButtonText" Text="{Binding [setup.welcome.begin]}" Foreground="White" FontSize="17" FontWeight="SemiBold" />
                                <Path Data="M 0,0 L 5,5 L 0,10" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="6" Height="10" Stretch="Uniform" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>

        </Grid>
    </Border>
</Window>
